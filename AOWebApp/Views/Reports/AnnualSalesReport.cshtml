@model SelectList

@{
    ViewBag.Title = "Annual Sales";
}
<h2>Annual Sales Report</h2>
<select name="year" asp-items="@Model" class="form-control">
    <option value="">Select...</option>
</select>
<svg width="100%" height="400px" class="border border-primary rounded p-2"></svg>

@section scripts {
    <script type="module">
        import * as d3 from "https://cdn.jsdelivr.net/npm/d3@7/+esm";

        var svg = d3.select("svg");

        let w = svg.node().getBoundingClientRect().width;
        let h = svg.node().getBoundingClientRect().height;

        const chartMargins = {
            left: 40,
            right: 25,
            top: 25,
            bottom: 80
        };

        w = w - (chartMargins.left + chartMargins.right);
        h = h - (chartMargins.top + chartMargins.bottom);


        console.log('Width: ' + w);
        console.log('Height: ' + h);

        document.querySelector('[name="year"]').addEventListener('change', (event) => {
            let year = event.target.value;
            console.log("Year: " + year);

            if (year.length > 0) {
                fetch(`/Reports/AnnualSalesReportData?year=${year}`)
                    .then(response => {
                        console.log("response status: " + response.status);
                        console.log("response text: " + response.statusText);
                        return response.json();
                    })
                    .then(data => buildGraph(data))
                    .catch(err => console.log(err.message));
            }
        });

        function buildGraph(dataSet) {
            // clear the graph first
            svg.selectAll('*').remove()

            console.log(dataSet);

            let totalItemsRange = d3.extent(dataSet, (d, i) => d.totalItems);
            let maxTotalItems = totalItemsRange[1];

            console.log("Max totalItems: " + maxTotalItems);

            const barMargin = 10;
            const barWidth = w / dataSet.length;

            let yScale = d3.scaleLinear()
                .domain([0, maxTotalItems])
                .range([h, 0]);

            let monthArray = Array.from(dataSet, (d, i) => d.monthName);
            console.log("array: " + monthArray)

            let xScale = d3.scaleBand()
                .domain(monthArray)
                .range([0, w])
                .paddingInner(0.1)

            console.log("xScale: " + xScale("March"))

            const chartGroup = svg.append('g')
                .classed('chartGroup', true)
                .attr('transform', `translate(${chartMargins.left},${chartMargins.top})`)


            let barGroups = chartGroup
                .selectAll('g')
                .data(dataSet);

            let newBarGroups = barGroups.enter()
                .append('g')
                .attr('transform', (d, i) => {
                    return `translate(${xScale(d.monthName)}, ${yScale(d.totalItems)})`;
                });

            newBarGroups
                .append('rect')
                .attr('x', 0)
                .attr('y', (d, i) => {
                    return h - yScale(d.totalItems);
                })
                .attr('height', 0)
                .attr('width', xScale.bandwidth())
                .transition()
                .duration('1000')
                .attr('y', 0)
                .attr('height', (d, i) => {
                    return h - yScale(d.totalItems);
                })
                .style('fill', (d, i) => `rgb(20, 20, ${i * 15 + 80})`);

            newBarGroups
                .append('text')
                .attr('text-anchor', 'middle')
                .attr('x', (d, i) => { return xScale.bandwidth() / 2; })
                .attr('y', 20)
                .style('fill', 'white')
                .style('font-size', '1rem')
                .text((d, i) => d.totalItems.toLocaleString());

            let yAxis = d3.axisLeft(yScale);
            chartGroup.append('g')
                .classed('axis y', true)
                .call(yAxis);

            let xAxis = d3.axisBottom(xScale);
            chartGroup.append('g')
                .attr('transform', `translate(0, ${h})`)
                .classed('axis x', true)
                .call(xAxis)

        };

    </script>
}